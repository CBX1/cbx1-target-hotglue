# Copy to .env and fill in. See AGENTS.md → "Environment variables".

# CBX1 Java backend base URL. TRAILING SLASH REQUIRED (code concatenates "api/…").
# QA:   http://java-backend.api.qa.cbx1.internal/
# Prod: ask #eng-crm-self-serve for the current value.
BASE_URL=

# Fallback CRM source when a record carries no `source` field.
# One of: SALESFORCE | HUBSPOT | MARKETO (default HUBSPOT).
CONNECTOR_ID=HUBSPOT

# Optional. HotGlue job identifier — only used for hgBatchId generation
# when inject_batch_ids is enabled in config.json.
# JOB_ROOT=
